# ============================================================================
# GeoKurir Malang - Environment Configuration Template
# Salin file ini menjadi .env: cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Google Maps Platform API Key
# ----------------------------------------------------------------------------
# Digunakan untuk:
#  - Geocoding Service: Menentukan koordinat akurat (Latitude & Longitude) dari alamat paket
#  - Render Peta: Memuat layer peta resmi Google Maps (Roadmap & Point of Interest)
# Masukkan API Key Google Maps Anda di bawah ini:
GOOGLE_MAPS_API_KEY=

# ----------------------------------------------------------------------------
# 2. Batas Jumlah Data Geocoding & Pemodelan
# ----------------------------------------------------------------------------
# - Isi 'None' (atau kosongkan) untuk memproses SELURUH baris data pada file dataset.
# - Atau isi angka tertentu (contoh: 22 untuk skenario uji cepat, 50, 100, dst.)
GEOCODING_LIMIT=None

# ----------------------------------------------------------------------------
# 3. Basis Data PostgreSQL
# ----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=geokurir
DB_PASSWORD=geokurir_secret
DB_NAME=geokurir_db

# ----------------------------------------------------------------------------
# 4. Web Database GUI (Adminer)
# ----------------------------------------------------------------------------
ADMINER_PORT=8080

# ----------------------------------------------------------------------------
# 5. Flask Web Server Configuration (Akses di http://localhost:5000)
# ----------------------------------------------------------------------------
FLASK_PORT=5000
SECRET_KEY=geokurir-malang-super-secret-key-2026
